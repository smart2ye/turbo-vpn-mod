<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="true">
        <rotate android:fromDegrees="0.0" android:toDegrees="0.0" android:pivotX="0.0%" android:pivotY="0.0%">
            <bitmap android:src="@drawable/bigo_ad_ic_web_forward_enable" />
        </rotate>
    </item>
    <item android:state_enabled="false" android:drawable="@drawable/bigo_ad_ic_web_back_disable" />
</selector>
