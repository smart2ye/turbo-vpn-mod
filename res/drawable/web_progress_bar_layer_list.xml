<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="0.0dp" />
            <gradient android:startColor="#ff252c3d" android:endColor="#ff252c3d" android:angle="0.0" android:centerY="0.75" android:centerColor="#ff252c3d" />
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress">
        <clip>
            <shape>
                <corners android:radius="0.0dp" />
                <gradient android:startColor="#fffa7b47" android:endColor="#fffa7b47" android:angle="0.0" android:centerY="0.75" android:centerColor="#fffa7b47" />
            </shape>
        </clip>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="0.0dp" />
                <gradient android:startColor="#fffa7b47" android:endColor="#fffa7b47" android:angle="0.0" android:centerY="0.75" android:centerColor="#fffa7b47" />
            </shape>
        </clip>
    </item>
</layer-list>
