<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="#ff9e4d" android:endColor="#ff6d33" android:useLevel="true" android:angle="0.0" android:type="linear" />
            <corners android:radius="@dimen/vip_page_btn_rounded_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#fadc63" android:endColor="#fa7a48" android:useLevel="true" android:angle="0.0" android:type="linear" />
            <corners android:radius="@dimen/vip_page_btn_rounded_radius" />
        </shape>
    </item>
</selector>
